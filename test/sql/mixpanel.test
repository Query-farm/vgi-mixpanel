3

# ------------------------------------------------------------------- discovery

query I
SELECT count(*) FROM duckdb_functions() WHERE database_name = 'mixpanel' AND function_name IN ('events', 'segmentation', 'funnel', 'retention', 'top_events', 'event_names', 'top_event_properties', 'event_property_values', 'profiles');
----
9

query T
SELECT string_agg(schema_name || '.' || table_name, ',' ORDER BY schema_name, table_name) FROM duckdb_tables() WHERE database_name = 'mixpanel';
----
main.annotations,main.cohorts,main.funnels,main.schema_properties,main.schemas,unified.cohorts,unified.event_definitions,unified.events,unified.property_definitions,unified.users

# Every request carried a credential and the project id (9999 is the 403 test above).
query I
SELECT count(*) FROM read_json('{MIXPANEL_FIXTURE_URL}/__requests') WHERE path NOT LIKE '/api/app/%' AND "user" <> '' AND json_extract_string(query, '$.project_id') NOT IN ('4242', '9999');
----
0
