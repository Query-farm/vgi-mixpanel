query TTIT
SELECT tool, cohort_id, size, updated_at FROM mixpanel.unified.cohorts ORDER BY size DESC;
----
mixpanel	2000	3	NULL
mixpanel	1000	2	NULL

query TTTTT
SELECT tool, user_id, email, country, last_seen_at FROM mixpanel.unified.users WHERE country = 'US' ORDER BY user_id;
----
mixpanel	u1	ada@example.com	US	2026-11-03 12:00:00+00
mixpanel	u3	alan@example.com	US	2026-11-03 09:00:00+00
mixpanel	u7	radia@example.com	US	2026-11-03 20:00:00+00

query T
SELECT json_extract_string(form, '$.where') FROM read_json('{MIXPANEL_FIXTURE_URL}/__requests?path=/api/query/engage') ORDER BY seq DESC LIMIT 1;
----
string(properties["$country_code"]) == "US"

query T
SELECT user_id FROM mixpanel.unified.users WHERE user_id = 'u6';
----
u6

query T
SELECT json_extract_string(form, '$.distinct_id') FROM read_json('{MIXPANEL_FIXTURE_URL}/__requests?path=/api/query/engage') ORDER BY seq DESC LIMIT 1;
