u6

# ------------------------------------------------------- Lexicon and annotations

query TTTTTTI
SELECT entity_type, name, display_name, is_hidden, is_dropped, tags::VARCHAR, property_count FROM mixpanel.main.schemas ORDER BY entity_type, name;
----
event	Debug Ping	NULL	true	true	[internal]	0
event	Page View	NULL	true	false	[]	0
event	Purchase	Purchase	false	false	[revenue, ecommerce]	3
event	Sign Up	Sign Up	false	false	[acquisition]	2
profile	$user	NULL	false	false	NULL	3

# entity_type = pushes down to /schemas/{entityType}.
query T
SELECT name FROM mixpanel.main.schemas WHERE entity_type = 'profile';
----
$user

query I
SELECT count(*) FROM read_json('{MIXPANEL_FIXTURE_URL}/__requests?path=/api/app/projects/4242/schemas/profile');
----
1

query TTTTT
SELECT entity_name, property_name, data_type, is_required, enum_values::VARCHAR FROM mixpanel.main.schema_properties WHERE entity_type = 'event' ORDER BY ALL;
----
Purchase	items	array	false	NULL
Purchase	plan	string	false	NULL
Purchase	revenue	number	true	NULL
Sign Up	campaign	string	false	NULL
Sign Up	plan	string	true	[free, basic, pro]

query TTTTT
SELECT tool, event_name, is_hidden, is_active, tags::VARCHAR FROM mixpanel.unified.event_definitions ORDER BY event_name;
----
mixpanel	Debug Ping	true	false	[internal]
mixpanel	Page View	true	true	[]
mixpanel	Purchase	false	true	[revenue, ecommerce]
mixpanel	Sign Up	false	true	[acquisition]

query TTTTT
SELECT scope, event_name, property_name, data_type, is_array FROM mixpanel.unified.property_definitions ORDER BY ALL;
----
event	Purchase	items	array	true
event	Purchase	plan	string	false
event	Purchase	revenue	number	false
event	Sign Up	campaign	string	false
event	Sign Up	plan	string	false
user	NULL	$email	string	false
user	NULL	plan	string	false
user	NULL	seats	integer	false

query T
SELECT property_name FROM mixpanel.unified.property_definitions WHERE scope = 'user' AND is_hidden;
----
seats

query I
SELECT count(*) FROM read_json('{MIXPANEL_FIXTURE_URL}/__requests?path=/api/app/projects/4242/schemas/profile');
----
2

query ITTTT
SELECT id, annotation_time, description, user_name, tags::VARCHAR FROM mixpanel.main.annotations WHERE annotation_time >= TIMESTAMPTZ '2026-11-01' ORDER BY id;
----
12	2026-11-01 09:00:00+00	Fall campaign launched	Grace Hopper	[Marketing]
13	2026-11-03 15:30:00+00	Checkout incident	NULL	[]

query TT
SELECT json_extract_string(query, '$.fromDate'), json_extract_string(query, '$.toDate') FROM read_json('{MIXPANEL_FIXTURE_URL}/__requests?path=/api/app/projects/4242/annotations') ORDER BY seq DESC LIMIT 1;
----
2026-11-01	NULL

query I
SELECT count(*) FROM mixpanel.main.annotations;
